# =============================================================================
# WhatsApp AI Assistant — environment configuration
# Copy this file to ".env" and fill in the values. NEVER commit your real .env.
# The app will start with blanks; each service simply reports "not configured"
# until its variables are filled in. Use the developer dashboard to test each one.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
# Port the developer dashboard + webhook server listens on.
PORT=3000
# SANDBOX (safe, default) or LIVE. Controls whether real bookings/calls happen.
# You can also flip this at runtime from the dashboard toggle.
MODE=SANDBOX
# Shared secret used to protect the dashboard + its API. Set any random string.
DASHBOARD_TOKEN=
# Verify the X-Twilio-Signature on inbound webhooks. Off by default so sandbox
# testing through a tunnel never fails on a URL mismatch. Set true in production.
TWILIO_VALIDATE_SIGNATURE=false

# ---- Claude (Anthropic) — the agent brain -----------------------------------
ANTHROPIC_API_KEY=
# Model used for reasoning/tool-calling.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- OpenAI — voice-note transcription (Whisper) ----------------------------
OPENAI_API_KEY=
# Transcription model. whisper-1 handles English/Hindi/Hinglish well.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ---- Twilio — WhatsApp messaging + outbound voice calls ---------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender. In SANDBOX use the Twilio sandbox number below (default works).
TWILIO_WHATSAPP_SANDBOX_FROM=whatsapp:+14155238886
# Your approved WhatsApp Business sender for LIVE mode, e.g. whatsapp:+1XXXXXXXXXX
TWILIO_WHATSAPP_LIVE_FROM=
# Voice-capable caller ID (a Twilio number you own), e.g. +1XXXXXXXXXX
TWILIO_VOICE_FROM=
# OPTIONAL: pre-approved WhatsApp template SID (HXXXXXXXX...) used for proactive
# messages sent OUTSIDE the 24-hour customer-service window. Leave blank to have
# the agent surface the limitation instead of silently failing.
TWILIO_TEMPLATE_SID=

# ---- Uber — ride booking ----------------------------------------------------
# OAuth bearer token (server token / access token) for the Uber API.
UBER_ACCESS_TOKEN=
# Base URLs. Sandbox is used automatically in SANDBOX mode.
UBER_SANDBOX_BASE_URL=https://sandbox-api.uber.com
UBER_LIVE_BASE_URL=https://api.uber.com

# ---- Owner / client identity ------------------------------------------------
# The single client's WhatsApp number (E.164), e.g. +12223334444. Used so the
# agent knows who "I/me" is and where to send the owner's own reminders.
OWNER_WHATSAPP_NUMBER=
OWNER_NAME=
# Public base URL of THIS server (for Twilio voice callbacks). Locally use an
# ngrok/tunnel URL, e.g. https://abcd-1234.ngrok-free.app
PUBLIC_BASE_URL=
